                "inputFormat": "plain",
                "row": "0-0"
              }
            ]
          },
          {
            "label": "START_DAY",
            "hideInputLabels": false,
            "inputsLabelPosition": "top",
            "useLocaleSettings": false,
            "tableView": false,
            "fields": {
                "day" : {
                    "hide" : true
                },
              "month": {
                "hide": false
              },
              "year": {
                "hide": false
              }
            },
            "key": "startDay",
